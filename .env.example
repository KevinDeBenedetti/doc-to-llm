# Read by docker-compose.yml (env_file) and by the server (src/core/config.py).
# Copy to .env and fill in. Leave optional lines commented out rather than
# empty: an empty value is read as "" and overrides the default.

# API key of the OpenAI-compatible endpoint (required).
OPENAI_API_KEY=

# Base URL of the endpoint; unset means api.openai.com.
# OPENAI_BASE_URL=https://api.example.com/v1

# Model used for AI enhancement and the default for translation.
# OPENAI_MODEL=gpt-4o-mini

# SQLAlchemy database URL; unset means sqlite:///./database.db.
# DATABASE_URL=sqlite:///./database.db
LOG_FILE=
